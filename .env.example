# Copy this file to .env and fill in real values locally.
# NEVER commit .env — it is already excluded via .gitignore.

ENV=development

# --- Storage ---
DATABASE_URL=sqlite:///./vaanireach.db
UPLOAD_DIR=./data/uploads

# --- Upload / file safety limits ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,png,jpg,jpeg

# --- Web ---
CORS_ORIGINS=http://localhost:3000

# --- Provider timeouts (seconds) ---
PROVIDER_TIMEOUT_SECONDS=30

# --- Provider API keys ---
# Comma-separated for horizontal key rotation (see providers/llm/gemini_client.py
# GeminiManager and the resilience managers added in later phases). A single
# GEMINI_API_KEY is also accepted as a 1-key pool. Used for text only (fact
# extraction/script generation/translation/verification) — B-roll image
# generation does NOT use Gemini, see HF_API_KEY below.
GEMINI_API_KEYS=

SARVAM_API_KEYS=

# Comma-separated. DID_API_KEYS entries are each a raw "username:password"
# string exactly as issued by D-ID — the client base64-encodes it itself.
HEDRA_API_KEYS=
DID_API_KEYS=

# B-roll / avatar-source image generation: Cloudflare Workers AI running
# @cf/black-forest-labs/flux-1-schnell (providers/visual/cloudflare_flux_provider.py)
# — the project's permanent image-generation provider. Requires a
# Cloudflare account id and an API token with Workers AI access
# (dash.cloudflare.com -> My Profile -> API Tokens). CLOUDFLARE_API_TOKENS
# is comma-separated for horizontal rotation across multiple tokens on a
# 429/auth error; a single CLOUDFLARE_API_TOKEN is also accepted as a
# 1-token pool. If Cloudflare is unconfigured or every token is
# exhausted, B-roll/avatar images fall back to a local placeholder card
# automatically.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKENS=

# Three earlier VisualProviders were tried and dropped before Cloudflare,
# each for a billing/quota wall: Google Imagen 3 needs a billing-enabled
# Google Cloud project even on free-tier Gemini keys, Hugging Face's free
# `hf-inference` tier (and Together AI, one of the backends its router
# can pick) started gating image generation behind billing/deposit, and
# Pollinations.ai's free public queue was fine for a demo but not the
# permanent answer. HF_API_KEY below is kept only because
# gemini_imagen_provider.py / huggingface_provider.py /
# pollinations_visual_provider.py remain in the codebase as
# working-but-unwired alternatives — none is used by the dashboard today.
HF_API_KEY=

# --- Optional avatar-tier tuning (sane defaults if unset) ---
# HEDRA_MODEL_ID=d1dd37a3-e39a-4854-a298-6510289f9cf2
# HEDRA_MODEL_SLUG=
# AVATAR_FALLBACK_ASSET=./fallback_assets/generic_hook.mp4

# --- Optional B-roll image / video-compositing tuning (sane defaults if unset) ---
# IMAGE_CACHE_DIR=./local_cache/images
# RENDERED_VIDEO_OUTPUT_DIR=./data/video/final
